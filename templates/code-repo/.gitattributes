# Outside the deployment archive (git archive): the tooling, the dev
# command and the batch folders. The archive of a commit = the deliverable, to the byte.
bench/              export-ignore
batches/            export-ignore
DEV_PROMPT_*.md     export-ignore
.gitattributes      export-ignore

# Line endings: do NOT normalize when importing existing code — the proof
# “git archive = original zip, to the byte” would fail on CRLF files.
# For a new project only, you can uncomment:
# * text=auto eol=lf
*.png  binary
*.jpg  binary
*.webp binary
*.pdf  binary
*.zip  binary
